# --- Claude (cerveau : chef de projet + factory) ---
ANTHROPIC_API_KEY=

# Modèles (voix = rapide, factory = profond)
CLEVERIA_VOICE_MODEL=claude-sonnet-4-6
CLEVERIA_FACTORY_MODEL=claude-opus-4-8

# --- LiveKit (transport voix temps réel) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT / TTS ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Source de vérité des agents factory ---
# Par défaut : le dossier global Claude Code de l'utilisateur (réutilisation des définitions existantes)
CLEVERIA_AGENTS_DIR=../.claude/agents

# --- Supabase (auth multi-tenant, projets, état des runs) — requis dès V2 ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
